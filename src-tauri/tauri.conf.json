{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Comic Fast",
  "version": "0.14.0",
  "identifier": "app.comicfast.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Comic Fast",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' data: blob: ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Editor de cómics ligero y multiplataforma",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "cfast"
        ],
        "name": "Proyecto de Comic Fast",
        "description": "Proyecto de Comic Fast",
        "mimeType": "application/x-comicfast"
      }
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
